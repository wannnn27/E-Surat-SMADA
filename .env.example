# Contoh konfigurasi. Aplikasi tidak memuat file .env secara otomatis.
# Simpan nilai produksi di konfigurasi service/secret manager, bukan di Git.
ESURAT_HOST=127.0.0.1
ESURAT_PORT=5000
ESURAT_THREADS=4

# Sangat direkomendasikan: seluruh data operasional berada di luar checkout Git.
# Struktur: <root>\source, <root>\master, dan <root>\runtime.
ESURAT_DATA_ROOT=D:\E-Surat-Private
# Override granular bila tata letak berbeda (opsional):
# ESURAT_SOURCE_DIR=D:\E-Surat-Private\source
# ESURAT_DATA_DIR=D:\E-Surat-Private\master
# ESURAT_DB_PATH=D:\E-Surat-Private\runtime\surat_smada.db

# Deployment Vercel: Supabase Transaction Pooler port 6543, disimpan sebagai
# secret provider. Jangan commit connection string/password database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Tetap 0 pada runtime. Migrasi schema dijalankan terpisah oleh script/admin.
ESURAT_AUTO_MIGRATE_DATABASE=0

# Wajib saat login admin aktif. Pengguna umum tidak perlu login.
# Nilai harus acak, stabil, dan privat.
ESURAT_SECRET_KEY=

# Akun administrator (direkomendasikan). File JSON privat berisi username,
# password_hash, role admin, dan active.
ESURAT_USERS_FILE=D:\E-Surat-Private\config\users.json

# Alternatif kompatibilitas untuk satu akun; jangan gunakan bersamaan dengan
# ESURAT_USERS_FILE.
# ESURAT_USERNAME=tu
# ESURAT_PASSWORD_HASH=
# ESURAT_DEFAULT_ROLE=admin

ESURAT_SESSION_HOURS=8
ESURAT_LOGIN_MAX_ATTEMPTS=5
ESURAT_LOGIN_WINDOW_SECONDS=900

# Identitas sekolah/format nomor.
# Opsional bila tepat satu record guru memiliki jabatan "Kepala Sekolah".
ESURAT_KEPSEK_NIP=
ESURAT_NUMBER_SUFFIX=SMADA
ESURAT_HTTPS=0
