# Salin menjadi .env hanya bila Anda memakai pemuat environment sendiri.
# Aplikasi membaca environment proses; jangan commit nilai rahasia.
ESURAT_HOST=127.0.0.1
ESURAT_PORT=5000
ESURAT_THREADS=4

# Isi untuk akses melalui LAN. Buat hash dengan:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash(input('Password TU: ')))"
ESURAT_USERNAME=tu
ESURAT_PASSWORD_HASH=
ESURAT_SECRET_KEY=

# Opsional: identitas sekolah/format nomor.
# Opsional bila tepat satu record guru memiliki jabatan "Kepala Sekolah".
ESURAT_KEPSEK_NIP=
ESURAT_NUMBER_SUFFIX=SMADA
ESURAT_HTTPS=0
